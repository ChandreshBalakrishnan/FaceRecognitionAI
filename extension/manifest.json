{
  "manifest_version": 3,
  "name": "Emotion Scroll",
  "version": "0.1.0",
  "description": "Skips past a video when your face says you are not enjoying it. Runs entirely on your own machine.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["*://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Emotion Scroll"
  }
}
